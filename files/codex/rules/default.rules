# General development command permissions.

prefix_rule(pattern = ["yarn"], decision = "allow", justification = "Allow Yarn commands.")
prefix_rule(pattern = ["yarn", "add"], decision = "prompt", justification = "Research packages with $check-dep before approving dependency additions.")
prefix_rule(pattern = ["pod"], decision = "allow", justification = "Allow CocoaPods commands.")
prefix_rule(pattern = ["xcrun"], decision = "allow", justification = "Allow xcrun commands.")
prefix_rule(pattern = ["xcodebuild"], decision = "allow", justification = "Allow xcodebuild commands.")
prefix_rule(pattern = ["jest"], decision = "allow", justification = "Allow Jest commands.")
prefix_rule(pattern = ["tsc"], decision = "allow", justification = "Allow TypeScript compiler commands.")
prefix_rule(pattern = ["adb"], decision = "allow", justification = "Allow Android Debug Bridge commands.")

prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "Allow git status.")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "Allow git diff.")
prefix_rule(pattern = ["git", "log"], decision = "allow", justification = "Allow git log.")
prefix_rule(pattern = ["git", "show"], decision = "allow", justification = "Allow git show.")
prefix_rule(pattern = ["git", "branch"], decision = "allow", justification = "Allow git branch.")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow", justification = "Allow git rev-parse.")
prefix_rule(pattern = ["git", "remote", "-v"], decision = "allow", justification = "Allow git remote inspection.")
prefix_rule(pattern = ["git", "stash", "list"], decision = "allow", justification = "Allow git stash inspection.")
prefix_rule(pattern = ["git", "add"], decision = "allow", justification = "Allow git staging.")
prefix_rule(pattern = ["git", "commit"], decision = "allow", justification = "Allow git commits; Codex secret scan hook runs first.")

prefix_rule(pattern = ["ls"], decision = "allow", justification = "Allow directory listing.")
prefix_rule(pattern = ["cat"], decision = "allow", justification = "Allow file reads.")
prefix_rule(pattern = ["head"], decision = "allow", justification = "Allow file reads.")
prefix_rule(pattern = ["tail"], decision = "allow", justification = "Allow file reads.")
prefix_rule(pattern = ["wc"], decision = "allow", justification = "Allow counts.")
prefix_rule(pattern = ["grep"], decision = "allow", justification = "Allow text search.")
prefix_rule(pattern = ["rg"], decision = "allow", justification = "Allow ripgrep search.")
prefix_rule(pattern = ["find"], decision = "allow", justification = "Allow filesystem search.")
prefix_rule(pattern = ["which"], decision = "allow", justification = "Allow executable lookup.")
prefix_rule(pattern = ["file"], decision = "allow", justification = "Allow file type inspection.")
prefix_rule(pattern = ["jq"], decision = "allow", justification = "Allow JSON inspection.")
prefix_rule(pattern = ["sw_vers"], decision = "allow", justification = "Allow macOS version inspection.")
prefix_rule(pattern = ["date"], decision = "allow", justification = "Allow date inspection.")

prefix_rule(pattern = ["npm", "view"], decision = "allow", justification = "Allow npm dependency research.")
prefix_rule(pattern = ["npm", "ls"], decision = "allow", justification = "Allow installed package inspection.")
prefix_rule(pattern = ["python3", "-c", "import sys,json; d=json.load(sys.stdin); print(json.dumps({k: d.get(k) for k in ['dependencies','devDependencies']}, indent=2))"], decision = "allow", justification = "Allow package metadata inspection.")
prefix_rule(pattern = ["python3", "-c", "import sys,json; d=json.load(sys.stdin); print(json.dumps(d.get('mcpServers', {}), indent=2))"], decision = "allow", justification = "Allow MCP configuration inspection.")
prefix_rule(pattern=["chmod", "+x"], decision="allow")
prefix_rule(pattern=["python3", "-m", "py_compile"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "{{HOME}}/.codex/hooks/__pycache__"], decision="allow")
prefix_rule(pattern=["codex", "doctor"], decision="allow")
prefix_rule(pattern=["codex", "--strict-config"], decision="allow")
prefix_rule(pattern=["npm", "pack"], decision="allow")
prefix_rule(pattern=["node", "{{HOME}}/.codex/skills/.system/openai-docs/scripts/fetch-codex-manual.mjs"], decision="allow")
prefix_rule(pattern=["codex", "mcp", "add"], decision="allow")
