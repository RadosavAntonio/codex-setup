# Sensitive commands require approval. Ordinary commands use the workspace sandbox.
prefix_rule(pattern = ["jest"], decision = "prompt", justification = "Project tests execute repository code and may write files")
prefix_rule(pattern = ["tsc"], decision = "prompt", justification = "TypeScript compilation may execute plugins and emit files")
prefix_rule(pattern = ["yarn"], decision = "prompt", justification = "Yarn can install dependencies and execute package scripts")
prefix_rule(pattern = ["pod"], decision = "prompt", justification = "CocoaPods can install dependencies and modify project files")
prefix_rule(pattern = ["xcrun"], decision = "prompt", justification = "Apple developer tools may modify devices, simulators, or signing state")
prefix_rule(pattern = ["xcodebuild"], decision = "prompt", justification = "Xcode builds execute project tooling and write build products")
prefix_rule(pattern = ["adb"], decision = "prompt", justification = "Android Debug Bridge can modify connected devices")
prefix_rule(pattern = ["git", "add"], decision = "prompt", justification = "Git staging changes repository index state")
prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "Git commit creates repository history; secret scanning hook remains active")
prefix_rule(pattern=["codex", "mcp", "login"], decision="prompt", justification = "MCP login changes external authentication state")
