{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/caveman-activate.sh",
            "timeout": 5,
            "additionalContextLimit": 3000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/destructive-git-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/scan-secrets.sh",
            "timeout": 15,
            "statusMessage": "Scanning staged changes for secrets"
          },
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/check-dep.sh",
            "timeout": 10,
            "statusMessage": "Checking dependency additions"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/eslint-fix.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/video-fps-reminder.py",
            "timeout": 5,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{HOME}}/.codex/hooks/stop-verify.sh",
            "timeout": 180,
            "statusMessage": "Verifying changed files (lint + types)"
          }
        ]
      }
    ]
  }
}
